# ============================================================
# MANOSETHU SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# Problem Statement: SIH26094 · Ministry of Social Justice and Empowerment
# ============================================================

# 1. AI SERVICE (GOOGLE GEMINI) — OPTIONAL (FALLBACK ACTIVE)
# Used server-side for multimodal signal extraction and explanation generation.
# If omitted, MANOSETHU runs seamlessly on deterministic local scoring engine.
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. FIREBASE WEB CONFIGURATION — CONFIGURED WITH DEFAULTS
# Used client-side for authentication and real-time continuity synchronization.
# Pre-configured with default credentials in src/lib/firebase.ts.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com

# 3. COMMUNICATION GATEWAY (TWILIO) — OPTIONAL (SIMULATION MODE ACTIVE)
# Used server-side for automated SMS check-in reminders and IVRS dispatch.
# If omitted, communication dispatcher runs in SIMULATED / QUEUED mode.
# Obtain from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_API_KEY=your_twilio_api_key
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_PHONE_NUMBER=your_twilio_phone_number
